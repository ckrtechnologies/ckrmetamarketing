# ── Server ────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── Supabase Cloud Database ───────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ── JWT Authentication ────────────────────────────────────────
JWT_SECRET=change_me_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# ── Meta / WhatsApp Cloud API Platform Settings ───────────────
META_GRAPH_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=ckrmetamarketing_verify_token

# ── File Upload & CDN ─────────────────────────────────────────
UPLOAD_DIR=uploads/
PUBLIC_DIR=/var/www/ckrtech/public
CDN_BASE_URL=https://cdn.ckrtechnologies.in
