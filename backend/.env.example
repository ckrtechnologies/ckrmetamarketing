# ── Server ────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── Supabase PostgreSQL ────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── JWT Auth ──────────────────────────────────────────────────
JWT_SECRET=change_me_super_secret_jwt_key_2026
